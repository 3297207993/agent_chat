{
  "name": "cambia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cambia — a general-purpose plugin kernel for Tauri (a standalone library; the adapter layer is its own workspace)",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "check": "pnpm -r build && pnpm -r typecheck && pnpm -r test && pnpm lint",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@cambia/eslint-config": "workspace:*",
    "@changesets/cli": "^3.0.3",
    "eslint": "^10.12.0",
    "typescript-eslint": "^8.71.1"
  }
}
