{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)*$",
      "description": "Plugin id, e.g. com.example.web-search"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable name"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "description": "Plugin version (semver)"
    },
    "engines": {
      "type": "object",
      "properties": {
        "cambia": {
          "type": "string",
          "minLength": 1,
          "description": "Kernel range, e.g. ^0.1"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "Host range as \"<host id>@<range>\", e.g. agent-chat@^0.1"
        }
      },
      "required": [
        "cambia",
        "host"
      ],
      "description": "The two version constraints a plugin declares (kernel.md 3)"
    },
    "activationEvents": {
      "default": [
        "always"
      ],
      "description": "\"always\" (with the app) or \"<prefix>:<pattern>\"; absent means \"always\"",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:always|[A-Za-z][A-Za-z0-9_-]*:\\S+)$"
      }
    },
    "parts": {
      "type": "object",
      "properties": {
        "frontend": {
          "description": "In-process Cordis plugin (single-file bundle, exports apply(ctx, config))",
          "type": "object",
          "properties": {
            "main": {
              "default": "frontend/main.js",
              "type": "string",
              "pattern": "^(?!\\.\\.?(?:\\/|$))(?!.*:)(?!.*\\\\)[A-Za-z0-9._-]+(?:\\/(?!\\.\\.?(?:\\/|$))[A-Za-z0-9._-]+)*$",
              "description": "Single-file ESM bundle of the plugin, relative to the package root"
            }
          }
        },
        "backend": {
          "description": "Out-of-process backend program",
          "type": "object",
          "properties": {
            "protocol": {
              "type": "string",
              "minLength": 1,
              "description": "Control-plane protocol; jsonrpc-stdio is the defined one"
            },
            "bin": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^(?:\\*|(?:win|mac|linux)(?:-(?:x64|arm64))?)$"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?!\\.\\.?(?:\\/|$))(?!.*:)(?!.*\\\\)[A-Za-z0-9._-]+(?:\\/(?!\\.\\.?(?:\\/|$))[A-Za-z0-9._-]+)*$",
                    "description": "Executable path relative to the package root"
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "argv of a command, resolved via PATH"
                  }
                ],
                "description": "Either a path to an executable, or an argv array"
              },
              "description": "Platform -> how to start it; unmatched platform means \"unsupported\""
            }
          },
          "required": [
            "protocol",
            "bin"
          ]
        },
        "view": {
          "description": "View document shown in a no-same-origin iframe",
          "type": "object",
          "properties": {
            "entry": {
              "type": "string",
              "pattern": "^(?!\\.\\.?(?:\\/|$))(?!.*:)(?!.*\\\\)[A-Za-z0-9._-]+(?:\\/(?!\\.\\.?(?:\\/|$))[A-Za-z0-9._-]+)*$",
              "description": "Standalone HTML document rendered in an iframe"
            }
          },
          "required": [
            "entry"
          ]
        }
      },
      "additionalProperties": false,
      "description": "Frontend / backend / view; anything else is a part this host cannot run"
    },
    "contributes": {
      "description": "Opaque to the kernel: vocabulary and shape belong to the host (kernel.md 1.9)",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "engines"
  ],
  "additionalProperties": {}
}
