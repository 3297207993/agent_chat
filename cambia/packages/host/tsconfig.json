{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "paths": {
      "@cambia/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src", "test", "vitest.config.ts", "tsup.config.ts"]
}
