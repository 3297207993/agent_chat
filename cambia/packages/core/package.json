{
  "name": "@cambia/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Cambia plugin kernel: freezes the plugin-facing API on top of Cordis (public API contract: kernel.md 5.3.1)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:publish": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.10"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "~5.8.3",
    "vitest": "^5.0.3"
  }
}
